#!/bin/bash
shopt -s expand_aliases
alias help='echo "Usage: cleanboot [-s]"'
if [[ "$1" == "--help" ]]; then help; exit; fi
################################################################################
###                                                                            #
### Script:   cleanboot [-s]                                                   #
###                                                                            #
### Purpose:  Clean TAF bootstrap directory                                    #
###                                                                            #
### Args:     s keep files and subfolders that are declared, instead of        #
###             removing data, library, and software folders completely        #
###                                                                            #
### Args:     s only remove files and subfolders that are not declared, rather #
###             than removing data, library, and software folders completely   #
###                                                                            #
### Requires: R, TAF                                                           #
###                                                                            #
### Returns:  Removes directories                                              #
###                                                                            #
################################################################################

if [[ -z $1 ]]; then
  Rscript --vanilla -e "TAF::clean.boot(force=TRUE)"
else
  Rscript --vanilla -e "TAF::clean.boot()"
fi
